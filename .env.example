# Copy to .env and fill in. Never commit .env.

# Public HTTPS address of the app (no trailing slash)
BASE_URL=https://example.sslip.io

# Random long string used to sign login cookies (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me

# Strava API app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; Strava echoes it back when verifying the webhook
STRAVA_VERIFY_TOKEN=change-me

# Strava athlete id of the club admin (you). Gets admin rights on first login.
ADMIN_STRAVA_ID=

# Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Web push (VAPID) keys: generate with `python -m app.cli vapid`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com

# Optional
DATABASE_PATH=data/club.db
LOG_DIR=logs
TIMEZONE=Asia/Bangkok
